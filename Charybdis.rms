/* Large ID-free starts preserve set_place_for_every_player behavior in DE. */
create_land {
    terrain_type HOME_GROUND
    number_of_tiles 820
    base_size 15
    land_position 14 14
    left_border 1
    right_border 73
    top_border 1
    bottom_border 73
    border_fuzziness 100
    clumping_factor 100
    other_zone_avoidance_distance 0
    zone SOUTHWEST_HOME_ZONE
    set_circular_base
    if PLAYER_ONE_SOUTHWEST
        assign_to_player 1
    else
        assign_to_player 2
    endif
}

